<?php
$file = "data.txt";

if ($_SERVER["REQUEST_METHOD"] == "POST" && isset($_POST["command"])) {
    $command = $_POST["command"];
    file_put_contents($file, $command . "\n", FILE_APPEND);
}

$data = file_exists($file) ? file($file) : [];
?>

<html>
<head><title>demo</title></head>
<body>

<form method="POST">
    <input type="text" name="command" placeholder="enter comments">
    <button type="submit">POST</button>
</form>

<h2>all comments</h2>

<?php
foreach ($data as $d) {
    echo htmlspecialchars($d, ENT_QUOTES, 'UTF-8') . "<br>";
}
?>

</body>
</html>
